// The App Store Connect record of the WorkStudio phone app (2026-11-13, the user's workstudio.mobileprovision).
#include "Version.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = com.gorilla.workstudio
DEVELOPMENT_TEAM = D39JR23NC7
// Signed by hand with the distribution certificate and the workstudio profile on the packaging Mac; Xcode never makes or
// changes either (the certificate also signs the team's games). Simulator builds are not signed.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = workstudio
